section#recommended.recommended
  .l-container
    h2.section-title.recommended__title Recommended
    .l-grid.recommended__list
      each product in productsList
        article.product-card.recommended__item
          .product-card__media
            +picture(product.image, product.title, 400, 400)
          h3.product-card__title= product.title
          p.product-card__desc= product.desc
          p.product-card__price= product.price

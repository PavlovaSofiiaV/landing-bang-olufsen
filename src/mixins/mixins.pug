mixin icon(name, width = 24, height = 24)
  svg(width=width, height=height, aria-hidden='true')&attributes(attributes)
    use(href=`#icon-${name}`)

mixin picture(name, alt, width = 600, height = 600, lazy = true, priority = false)
  picture&attributes(attributes)
    source(srcset=`/src/assets/images/${name}.avif`, type='image/avif')
    source(srcset=`/src/assets/images/${name}.webp`, type='image/webp')
    img(
      src=`/src/assets/images/${name}.jpg`,
      alt=alt,
      width=width,
      height=height,
      loading=lazy ? 'lazy' : false,
      fetchpriority=priority ? 'high' : false,
      decoding='async'
    )
